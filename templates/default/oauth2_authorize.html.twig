{% extends "public_page.html.twig" %}

{% set ext_auth = true %}
{% block content %}
    <form action="{{ url_for('oauth2_doAuthorize') }}?{{ querystring }}" method="post" class="ui form">
            <div class="ui segment">
                <div class="ui cards">
    {% for requested_scope in requested_scopes %}
                    <div class="ui fluid horizontal small card">
                        <div class="content">
                            <div class="header">
                                {{ requested_scope }}
        {% if requested_scope == 'member' %}
                                <i class="ui check circle green large icon right floated tooltip" title="{{ _T('Default scope is mandatory and cannot be unselected', 'oauth2') }}"></i>
        {% else %}
                                <div class="ui invisible checkbox right floated">
                                    <input type="checkbox" id="scope_{{ requested_scope }}" name="scopes[]" checked="checked" value="{{ requested_scope }}">
                                    <label for="scope_{{ requested_scope }}" class="image tooltip" title="{{ _T('Toggle scope approval', 'oauth2') }}">
                                        <i class="ui check circle green large icon"></i>
                                    </label>
                                </div>
        {% endif %}
                            </div>
                            <div class="description">
                                {{ known_scopes[requested_scope]['description'] }}
                            </div>
                        </div>
                    </div>
    {% endfor %}
                </div>
                <br/>

                {% include "components/forms/csrf.html.twig" %}

                <div class="ui mobile reversed stackable two column grid">
                    <div class="column center aligned">
                        <button type="submit" name="refuse" class="ui fluid large button">
                            {{ _T("Cancel", "oauth2") }}
                        </button>
                    </div>
                    <div class="column center aligned">
                        <button type="submit" name="approve" class="ui primary fluid large button">
                            {{ _T("Allow", "oauth2") }}
                        </button>
                    </div>
                </div>
            </div>
    </form>
{% endblock %}
