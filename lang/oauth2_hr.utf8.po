#: ../lib/GaletteOAuth2/Controllers/AuthorizationController.php:74
#: ../lib/GaletteOAuth2/Controllers/LoginController.php:270
#, php-format
msgid "Sign in with %s"
msgstr "Prijavi se putem %s"

#: ../lib/GaletteOAuth2/Controllers/AuthorizationController.php:79
#, php-format
msgid "%s is requesting access to the following details"
msgstr "Aplikacija %s traži pristup sljedećim podacima"

#: ../lib/GaletteOAuth2/Controllers/AuthorizationController.php:200
#: ../lib/GaletteOAuth2/Controllers/LoginController.php:219
msgid "An error occurred"
msgstr "Došlo je do pogreške"

#: ../lib/GaletteOAuth2/Controllers/LoginController.php:82
#: ../lib/GaletteOAuth2/Middleware/Authentication.php:65
msgid "Unknown client application"
msgstr "Nepoznata klijentska aplikacija"

#: ../lib/GaletteOAuth2/Controllers/LoginController.php:225
#: ../templates/default/oauth2_error.html.twig:15
msgid "OAuth2 error"
msgstr "OAuth2 pogreška"

#: ../lib/GaletteOAuth2/Controllers/LoginController.php:275
#, php-format
msgid "Sign in to %s"
msgstr "Prijavi se u %s"

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:79
msgid "Cannot OAuth login from superadmin account!"
msgstr "OAuth prijava s računom glavnog administratora nije moguća!"

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:97
msgid "Check your login / email or password."
msgstr "Provjerite korisničko ime / e-poštu ili lozinku."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:129
msgid "User not found."
msgstr "Korisnik nije pronađen."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:134
msgid "Sorry, you can't login because you are not an active member."
msgstr "Ne možete se prijaviti jer niste aktivan član."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:139
msgid "Sorry, you can't login. Please, add an email address to your account."
msgstr "Ne možete se prijaviti. Dodajte adresu e-pošte svojem računu."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:145
msgid "Sorry, you can't login because you are not a team member."
msgstr "Ne možete se prijaviti jer niste član uprave."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:153
msgid "Sorry, you can't login because you are not an up-to-date member."
msgstr "Ne možete se prijaviti jer vaša članarina nije podmirena."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:164
#, php-format
msgid "Default scope (%s) has not been authorized."
msgstr "Zadani opseg pristupa (%s) nije odobren."

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:38
msgid ""
"Access to your member basic information: name, login, email, language, status"
msgstr ""
"Pristup vašim osnovnim članskim podacima: ime, korisničko ime, e-pošta, "
"jezik, status"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:41
msgid ""
"Access to more precise personal data: birth date, job, gender, birth place, "
"GnuPG ID"
msgstr ""
"Pristup detaljnijim osobnim podacima: datum rođenja, zanimanje, spol, mjesto "
"rođenja, GnuPG ID"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:44
msgid "Access to your localization data: zipcode, town, region, country"
msgstr ""
"Pristup podacima o vašoj lokaciji: poštanski broj, mjesto, regija, država"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:47
msgid "Access to your precise localization data: full address"
msgstr "Pristup vašoj točnoj lokaciji: puna adresa"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:50
msgid "Access to your phone numbers"
msgstr "Pristup vašim telefonskim brojevima"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:53
msgid "Access to your social networks data"
msgstr "Pristup vašim podacima o društvenim mrežama"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:56
msgid "Access to the groups you belong to"
msgstr "Pristup grupama kojima pripadate"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:59
msgid "Access to your due date"
msgstr "Pristup datumu isteka vašeg članstva"

#: ../templates/default/oauth2_authorize.html.twig:22
msgid "Default scope is mandatory and cannot be unselected"
msgstr "Zadani opseg pristupa obvezan je i ne može se odznačiti"

#: ../templates/default/oauth2_authorize.html.twig:36
msgid "Cancel"
msgstr "Odustani"

#: ../templates/default/oauth2_authorize.html.twig:41
msgid "Allow"
msgstr "Dopusti"
