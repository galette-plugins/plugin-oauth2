#: ../lib/GaletteOAuth2/Controllers/LoginController.php:112
msgid "Check your login / email or password."
msgstr "Vérifiez votre login/courriel ou mot de passe."

#: ../lib/GaletteOAuth2/Controllers/LoginController.php:200
#: ../lib/GaletteOAuth2/Controllers/AuthorizationController.php:132
#, php-format
msgid "Sign in with %s"
msgstr "Se connecter avec %s"

#: ../lib/GaletteOAuth2/Controllers/LoginController.php:205
#, php-format
msgid "Sign in %s"
msgstr "Connecter %s"

#: ../lib/GaletteOAuth2/Controllers/AuthorizationController.php:137
#, php-format
msgid "%s is requesting access to the following details"
msgstr "%s requiert l'accès aux détails suivants"

#: ../lib/GaletteOAuth2/Controllers/AuthorizationController.php:219
#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:159
#, php-format
msgid "Default scope (%s) has not been authorized."
msgstr "Le périmètre par défaut (%s) n'a pas été autorisé."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:71
msgid "Cannot OAuth login from superadmin account!"
msgstr "Impossible de se connecter au compte superadmin avec OAuth !"

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:124
msgid "User not found."
msgstr "Utilisateur non trouvé."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:129
msgid "Sorry, you can't login because you are not an active member."
msgstr ""
"Désolé, vous ne pouvez pas vous connecter car vous n'êtes pas membre de "
"l'équipe."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:134
msgid "Sorry, you can't login. Please, add an email address to your account."
msgstr ""
"Désolé, vous ne pouvez pas vous connecter. Veuillez ajouter une adresse de "
"courriel valide à votre compte."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:140
msgid "Sorry, you can't login because your are not a team member."
msgstr "Désolé, vous n'êtes pas membre de l'équipe."

#: ../lib/GaletteOAuth2/Authorization/UserHelper.php:148
msgid "Sorry, you can't login because your are not an up-to-date member."
msgstr ""
"Désolé, vous ne pouvez pas vous connecter car vous n'êtes pas à jour de "
"votre cotisation."

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:54
msgid "OpenID Connect authentication (required for OIDC)"
msgstr "Authentification OpenID Connect (requis pour OIDC)"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:57
msgid "Access to your profile information: name, nickname, locale, gender, birthdate"
msgstr "Accès à vos informations de profil : nom, surnom, langue, genre, date de naissance"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:60
msgid "Access to your email address"
msgstr "Accès à votre adresse de courriel"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:63
msgid "Access to your postal address"
msgstr "Accès à votre adresse postale"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:66
msgid "Access to your phone number"
msgstr "Accès à votre numéro de téléphone"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:70
msgid ""
"Access to your member basic information: name, login, email, language, "
"company name)"
msgstr ""
"Accès à vos informations adhérent de base : nom, login, courriel, langue, "
"nom de l'entreprise"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:48
msgid ""
"Access to more precise personal data: birth date, job, gender, birth place, "
"GnuPG ID"
msgstr ""
"Accès à de plus précises informations : date de naissance, emploi, genre, "
"lieu de naissance, ID GnuPG"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:51
msgid "Access to your localization data: zipcode, town, region, country"
msgstr "Accès à vos données de localisation : code postal, ville, région, pays"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:54
msgid ""
"Access to your precise localisation data: full address, coordinates (from "
"maps plugin)"
msgstr ""
"Accès à vos données précises de localisation : adresse complète, coordonnées "
"(depuis le plugin maps)"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:57
msgid "Access to your phone numbers"
msgstr "Accès à vos numéros de téléphone"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:60
msgid "Access to your social networks data"
msgstr "Accès à vos informations de réseaux sociaux"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:63
msgid "Access to the groups you belong to"
msgstr "Accès aux groupes auxquels vous appartenez"

#: ../lib/GaletteOAuth2/Repositories/ScopeRepository.php:66
msgid "Access to your due date"
msgstr "Accès à votre date d'échéance"

#: ../tempcache/oauth2_authorize.html.twig:86
msgid "Default scope is mandatory and cannot be unselected"
msgstr "Le périmètre par défaut est obligatoire et ne peut être désélectionné"

#: ../tempcache/oauth2_authorize.html.twig:102
msgid "Toggle scope approval"
msgstr "Inverser l'approbation des périmètres"

#: ../tempcache/oauth2_authorize.html.twig:138
msgid "Cancel"
msgstr "Annuler"

#: ../tempcache/oauth2_authorize.html.twig:146
msgid "Allow"
msgstr "Autoriser"

